# Ignore everything by default
*

# Allow directories
!*/

# Whitelist web-related files
!index.html
!style.css
!.gitignore
!README.md
!rules.json
!rule list/rules.json
!word list/dictionary_updater.ipynb

# Exclude local environments, system caches, and secrets
.venv/
__pycache__/
.ipynb_checkpoints/
gcp_keys.json
.env
.env.*
.DS_Store
Thumbs.db
*.tmp
~$*

